{
  "permissions": {
    "allow": [
      "Bash(dbtf build:*)",
      "Bash(dbtf test:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run python -m mypy:*)",
      "Bash(python eval/:*)",
      "Bash(bash scripts/:*)",
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Edit(**/eval/eval_*.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(./.env)",
      "Edit(**/*.p8)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-changes.sh\"" }
        ]
      }
    ]
  }
}
